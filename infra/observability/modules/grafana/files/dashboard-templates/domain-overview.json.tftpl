{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": ["${domain_key}"],
      "targetBlank": false,
      "title": "${domain_title}",
      "type": "dashboards"
    },
    {
      "asDropdown": true,
      "icon": "apps",
      "includeVars": false,
      "keepTime": true,
      "tags": ["docflow"],
      "targetBlank": false,
      "title": "Todos os dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Linhas de log",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [],
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum(count_over_time({container=~\"$container\"} |~ \"(?i)$search\" [$__range]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Erros",
      "description": "Linhas contendo error / exception / fatal / panic / critical.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum(count_over_time({container=~\"$container\"} |~ \"(?i)$search\" |~ \"(?i)(error|erro|exception|fatal|panic|critical)\" [$__range]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avisos",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum(count_over_time({container=~\"$container\"} |~ \"(?i)$search\" |~ \"(?i)(warn|warning)\" [$__range]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Contêineres emitindo logs",
      "description": "Do domínio ${domain_title}. Se este número cair sem motivo, um serviço parou de logar — vale investigar antes de esperar um erro aparecer.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "count(sum by (container) (count_over_time({container=~\"$container\"}[$__range])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Taxa de logs por contêiner",
      "description": "Clique numa série para abrir os logs daquele contêiner com o mesmo intervalo de tempo.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "linhas/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "links": [
            {
              "targetBlank": false,
              "title": "Abrir logs de $${__field.labels.container}",
              "url": "/d/docflow-container-logs/?var-container=$${__field.labels.container}&$${__url_time_range}"
            }
          ],
          "mappings": [],
          "min": 0,
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "{{container}}",
          "expr": "sum by (container) (rate({container=~\"$container\"} |~ \"(?i)$search\" [$__auto]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Erros por contêiner",
      "description": "Total de linhas de erro no intervalo. Clique para abrir o detalhe do contêiner.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-YlRd" },
          "links": [
            {
              "targetBlank": false,
              "title": "Abrir logs de $${__data.fields.container}",
              "url": "/d/docflow-container-logs/?var-container=$${__data.fields.container}&var-severidade=(error%7Cerro%7Cexception%7Cfatal%7Cpanic%7Ccritical)&$${__url_time_range}"
            }
          ],
          "mappings": [],
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [], "fields": "", "values": true },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "{{container}}",
          "expr": "sum by (container) (count_over_time({container=~\"$container\"} |~ \"(?i)$search\" |~ \"(?i)(error|erro|exception|fatal|panic|critical)\" [$__range]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Taxa de erros por contêiner",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "erros/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 0,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "links": [
            {
              "targetBlank": false,
              "title": "Abrir logs de $${__field.labels.container}",
              "url": "/d/docflow-container-logs/?var-container=$${__field.labels.container}&$${__url_time_range}"
            }
          ],
          "mappings": [],
          "min": 0,
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "{{container}}",
          "expr": "sum by (container) (rate({container=~\"$container\"} |~ \"(?i)$search\" |~ \"(?i)(error|erro|exception|fatal|panic|critical)\" [$__auto]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Somente erros e avisos",
      "description": "Este painel filtra deliberadamente. Para o stream completo, use o dashboard Logs por Contêiner.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 21 },
      "options": {
        "dedupStrategy": "signature",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "expr": "{container=~\"$container\"} |~ \"(?i)$search\" |~ \"(?i)(error|erro|exception|fatal|panic|critical|warn|warning)\""
        }
      ]
    }
  ],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["docflow", "dominio", "${domain_key}"],
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Contêiner",
        "description": "Restrito aos contêineres do domínio ${domain_title}.",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(container)",
        "query": { "label": "container", "refId": "LokiVariableQueryEditor-VariableQuery", "type": 1 },
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "includeAll": true,
        "allValue": "${container_regex}",
        "multi": true,
        "refresh": 2,
        "regex": "/^(${container_regex})$/",
        "sort": 1,
        "hide": 0
      },
      {
        "name": "search",
        "label": "Buscar texto",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "options": [],
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "${domain_title} · Visão do domínio",
  "uid": "docflow-dominio-${domain_key}",
  "version": 1,
  "weekStart": ""
}
