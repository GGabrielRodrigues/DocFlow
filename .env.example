# =============================================================================
# DocFlow — Variáveis de Ambiente para Desenvolvimento Local (.env.example)
# Copie para .env: cp .env.example .env (ou rode `make env`)
# NUNCA versione o arquivo .env com credenciais reais de produção.
# =============================================================================

# --- Ambiente ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_DB=docflow_dev
POSTGRES_USER=docflow
POSTGRES_PASSWORD=docflow_dev_secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://docflow:docflow_dev_secret@localhost:5432/docflow_dev

# --- Redis (docker-compose.dev.yml) ---
REDIS_PASSWORD=docflow_redis_dev_secret
REDIS_PORT=6379
REDIS_URL=redis://default:docflow_redis_dev_secret@localhost:6379/0

# --- Silo Object Storage S3-compatível (docker-compose.dev.yml) ---
SILO_ROOT_USER=silo_admin
SILO_ROOT_PASSWORD=silo_admin_dev_secret
SILO_API_PORT=9000
SILO_CONSOLE_PORT=9001
S3_INTERNAL_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=docflow_app_dev
S3_SECRET_KEY=docflow_app_dev_secret
S3_BUCKET_MEDIA_RAW=media-raw
S3_BUCKET_MEDIA_PROCESSED=media-processed
S3_BUCKET_DOCUMENTS=documents

# --- Mailpit — Servidor SMTP Local (docker-compose.dev.yml) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@docflow.local

# --- Backend API (FastAPI) & Segurança ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://localhost:3000
JWT_SECRET_KEY=dev-only-jwt-secret-key-change-in-production-0123456789abcdef
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Provedores de IA (use "fake" em dev/testes para não consumir créditos) ---
TRANSCRIPTION_PROVIDER=fake
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

LLM_PROVIDER=fake
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Frontend (apps/web) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
