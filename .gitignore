# =============================================================================
# DocFlow Monorepo — .gitignore
# =============================================================================

# --- Segredos e variáveis de ambiente (NUNCA versionar segredos) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# --- Node.js / Frontend (apps/web) ---
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Python / Backend & Workers (apps/server) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.uv/
.pytest_cache/
.hypothesis/
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
celerybeat-schedule
celerybeat.pid

# --- Terraform / Infraestrutura (infra/) ---
**/.terraform/
**/.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- Testes e E2E ---
playwright-report/
test-results/
blob-report/
playwright/.cache/

# --- IDEs, Editores e Sistema Operacional ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.log
tmp/
temp/
